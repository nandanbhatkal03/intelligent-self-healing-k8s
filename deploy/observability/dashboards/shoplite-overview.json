      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 14,
   "type": "logs",
   "title": "ShopLite logs (Loki) — click trace_id to open the trace",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "h": 10,
    "w": 24,
    "x": 0,
    "y": 36
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{k8s_namespace_name=\"shoplite\"}",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   }
  },
  {
   "id": 15,
   "type": "logs",
   "title": "Kubernetes events — shoplite (Objective 2: cluster events; Warning = problem)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 46
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{service_name=\"k8s-events\"} | json | object_regarding_namespace=\"shoplite\" | line_format \"{{.object_type}}  {{.object_reason}}  {{.object_regarding_kind}}/{{.object_regarding_name}}  {{.object_note}}\""
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending"
   },
   "description": "All Kubernetes events for the shoplite namespace (Normal and Warning). A quiet cluster has few events, so this panel can be empty until a pod is restarted, scaled or a fault is injected. The detector itself only uses Warning events (classification.py)."
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 }
}

# Helm chart version pins. Leave empty to install the latest chart.
# After your first successful `make up`, run `helm list -A` and copy the
# CHART versions here so the evaluation cluster can be rebuilt identically
# (needed for repeatable MTTR/MTBF numbers, SRS NFR-11).
KPS_CHART_VERSION="91.8.2"       # prometheus-community/kube-prometheus-stack
BLACKBOX_CHART_VERSION="11.19.1"       # prometheus-community/prometheus-blackbox-exporter
LOKI_CHART_VERSION="7.3.0"       # grafana/loki
OTEL_CHART_VERSION="0.174.1"       # open-telemetry/opentelemetry-collector
CHAOS_MESH_CHART_VERSION="2.8.4"     # chaos-mesh/chaos-mesh
